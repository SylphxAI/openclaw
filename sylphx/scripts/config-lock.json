{
  "models": {
    "providers": {
      "anthropic": null,
      "minimax": null,
      "zai": null,
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "api": "openai-responses",
        "timeoutSeconds": 600,
        "models": [
          {
            "api": "openai-responses",
            "contextWindow": 200000,
            "id": "deepseek-flash",
            "input": ["text"],
            "maxTokens": 65536,
            "name": "DeepSeek 4.1 Flash",
            "reasoning": true,
            "compat": {
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "reasoningEffortMap": {
                "xhigh": "max",
                "max": "max"
              }
            },
            "thinkingLevelMap": {
              "xhigh": "max",
              "max": "max"
            }
          },
          {
            "api": "openai-responses",
            "contextWindow": 200000,
            "id": "deepseek-v4-flash",
            "input": ["text"],
            "maxTokens": 8192,
            "name": "DeepSeek V4 Flash",
            "reasoning": true
          }
        ]
      },
      "sylphx": {
        "baseUrl": "https://api.sylphx.ai/v1",
        "timeoutSeconds": 600,
        "models": [
          {
            "api": "openai-responses",
            "contextWindow": 272000,
            "id": "auto",
            "input": ["text", "image"],
            "maxTokens": 64000,
            "name": "Auto",
            "reasoning": true
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "deny": null,
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "telegram": ["*"]
      }
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off",
      "strictInlineEval": false,
      "timeoutSec": 7200,
      "applyPatch": {
        "enabled": true,
        "workspaceOnly": false
      }
    }
  },
  "messages": {
    "visibleReplies": "automatic",
    "groupChat": {
      "visibleReplies": "automatic"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-flash",
        "fallbacks": []
      },
      "elevatedDefault": "full",
      "blockStreamingDefault": "off",
      "toolProgressDetail": "explain",
      "sandbox": {
        "mode": "off"
      },
      "workspace": "/workspace",
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 1,
        "archiveAfterMinutes": 120
      },
      "memorySearch": {
        "enabled": true,
        "sync": {
          "onSessionStart": false,
          "onSearch": true,
          "watch": false,
          "watchDebounceMs": 10000
        }
      }
    }
  },
  "channels": {
    "telegram": {
      "mediaMaxMb": 100,
      "network": {
        "dnsResultOrder": "ipv4first"
      },
      "streaming": {
        "mode": "progress",
        "preview": {
          "toolProgress": true,
          "commandText": "status"
        },
        "progress": {
          "toolProgress": true,
          "commandText": "status"
        },
        "block": {
          "enabled": false
        }
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": false
    }
  },
  "skills": {
    "load": {
      "watch": false,
      "watchDebounceMs": 10000
    }
  },
  "diagnostics": {
    "enabled": true,
    "flags": ["timeline"]
  },
  "gateway": {
    "port": 3000,
    "reload": {
      "mode": "restart",
      "debounceMs": 1000
    },
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    }
  }
}
